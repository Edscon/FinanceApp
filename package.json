{
  "name": "financeapp",
  "private": true,
  "description": "Estilos (Tailwind v4) y librerías JS de la web. Solo hace falta para cambiar estilos o actualizar librerías: los ficheros compilados están en static/.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.10",
    "htmx.org": "^2.0.4",
    "lightweight-charts": "^5.0.0",
    "tailwindcss": "^4.1.10"
  }
}
