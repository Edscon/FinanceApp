# Copia este fichero a .env (en la raíz del repo) y rellena los valores.
# .env está en .gitignore: NO lo subas a git.

# Clave de Financial Modeling Prep (https://site.financialmodelingprep.com/)
FMP_API_KEY=

# Django. En desarrollo puedes dejar esto tal cual (DEBUG=True por defecto).
# En producción: DJANGO_DEBUG=False y una DJANGO_SECRET_KEY propia (obligatoria).
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# Opcional: ruta alternativa del SQLite (por defecto db.sqlite3 en la raíz).
# DB_PATH=
